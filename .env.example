# PostgreSQL
POSTGRES_DB=youtube_research
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Spring Boot
SPRING_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/youtube_research
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_characters
JWT_EXPIRATION=86400000
JWT_ISSUER=youtube-research-agent
JWT_AUDIENCE=web-client

# YouTube API
YOUTUBE_API_KEY=change_me

# LLM service
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://host.docker.internal:1234
OLLAMA_MODEL=mistralai/mistral-7b-instruct-v0.3